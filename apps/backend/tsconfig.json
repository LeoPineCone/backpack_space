{
  "$comment": "The backend runs on Node (Lambda and the local server). src/domain stays free of AWS, clock and random: see eslint.config.js.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "noEmit": true
  },
  "include": ["src", "local", "test"]
}
