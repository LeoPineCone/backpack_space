    { "id": "energy", "group": "fight", "en": "Energy", "de": "Energie", "icon": "energy", "text": "Every weapon attack costs Energy; pets attack without it. You start with {energy.start}, it refills by {energy.regen} per second up to {energy.max}. A weapon without enough Energy waits.", "code": ["rules.energy", "item.energy", "do: energy"] },
    { "id": "energyRegen", "group": "effect", "en": "Energy refill", "de": "Energie-Nachschub", "icon": "energyRegen", "text": "More Energy per second.", "code": ["mod.energyRegen"] },
