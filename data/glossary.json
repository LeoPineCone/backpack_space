    { "id": "artifact", "group": "rarity", "en": "Artifact", "de": "Artefakt", "text": "Free special item, never sold. Signature artifact after round 2, general artifact after round 6.", "code": ["rarity: artifact", "takeSpecial", "rules.specials"] },
    { "id": "signature_artifact", "group": "rarity", "en": "Signature artifact", "de": "Helden-Artefakt", "text": "One of the hero's own artifacts.", "code": ["Hero.artifacts", "pool: hero"] },
