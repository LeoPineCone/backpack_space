    { "id": "supernova", "group": "clock", "en": "Supernova", "de": "Supernova", "text": "After the last phase both heroes lose more health every second, through Shield.", "code": ["rules.battle.supernova", "supernovaResist"] },

    { "id": "shield", "group": "buff", "en": "Shield", "de": "Schild", "icon": "shield", "text": "Blocks damage before health." },
