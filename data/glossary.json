  "terms": [
    { "id": "run", "group": "run", "en": "Run", "de": "Lauf", "text": "One game from hero choice to the end: {rounds} rounds or until the lives are gone.", "code": ["RunState", "newRun"] },
    { "id": "round", "group": "run", "en": "Round", "de": "Runde", "text": "Shop and packing, then one fight.", "code": ["RunState.round"] },
    { "id": "life", "group": "run", "en": "Life", "de": "Leben", "text": "A run starts with {lives}. A lost fight costs one.", "code": ["RunState.lives", "rules.lives"] },
    { "id": "gold", "group": "run", "en": "Gold", "de": "Gold", "text": "Money for the shop, paid every round.", "code": ["RunState.gold", "rules.goldPerRound"] },
    { "id": "giveUp", "group": "run", "en": "Give up", "de": "Aufgeben", "icon": "flag", "text": "Ends the run in the shop. The reward counts the rounds fought so far.", "code": ["giveUp"] },
    { "id": "galaxies", "group": "meta", "en": "Galaxies", "de": "Galaxien", "icon": "galaxy", "text": "Earned after every run: wins plus lives left. They move the season pass and the planet track.", "code": ["Profile.galaxies", "meta.run.galaxies", "runGalaxies"] },
    { "id": "credits", "group": "meta", "en": "Credits", "de": "Credits", "icon": "credits", "text": "Premium currency for skins and heroes of earlier seasons. Bought, or earned slowly.", "code": ["Profile.credits"] },
    { "id": "heroXp", "group": "meta", "en": "Hero XP", "de": "Helden-XP", "icon": "xp", "text": "Every run gives the hero you played XP. XP raises the hero's level; levels give cosmetics.", "code": ["Profile.heroXp", "meta.heroLevels", "heroLevel"] },
    { "id": "planetTrack", "group": "meta", "en": "Planet track", "de": "Planeten-Strang", "icon": "planet", "text": "Permanent track across seasons, moved by Galaxies. Gives planets as menu backgrounds.", "code": ["meta.planetTrack"] },
    { "id": "seasonPass", "group": "meta", "en": "Season pass", "de": "Season-Pass", "icon": "pass", "text": "Track of one season, moved by Galaxies. Free rewards for everyone, premium rewards with the premium pass.", "code": ["meta.seasons.pass", "passLevel"] },
    { "id": "premiumPass", "group": "meta", "en": "Premium pass", "de": "Premium-Pass", "icon": "premium", "text": "The paid side of the season pass: the season's new hero from level 1, skins, grid backgrounds.", "code": ["SeasonState.premium", "unlockPremium"] },
    { "id": "season", "group": "meta", "en": "Season", "de": "Season", "text": "A stretch of time with its own pass and league race. A new season brings a new hero.", "code": ["meta.seasons", "SeasonState"] },
    { "id": "league", "group": "meta", "en": "League", "de": "Liga", "icon": "league", "text": "Your rank. Runs win or lose league points; a league you reached cannot be lost. A new season starts in the highest league of the next lower league group; Amateur leagues stay.", "code": ["meta.leagues", "leagueOf"] },
    { "id": "patch", "group": "meta", "en": "League patch", "de": "Liga-Patch", "icon": "patch", "text": "Paid at the end of a season for the league you reached. Wear one on your profile.", "code": ["patchId", "Profile.equipped.patch"] },
    { "id": "profileLevel", "group": "meta", "en": "Profile level", "de": "Profilstufe", "icon": "xp", "text": "The number on your picture: the levels of all your heroes added up.", "code": ["profileLevel"] },
    { "id": "cosmetic", "group": "meta", "en": "Cosmetic", "de": "Kosmetik", "icon": "skin", "text": "Changes the look only, never the game: skins, backgrounds, grid backgrounds, patches.", "code": ["meta.cosmetics"] },
    { "id": "skin", "group": "meta", "en": "Skin", "de": "Skin", "text": "Another look for one hero. Worn in the profile.", "code": ["Profile.equipped.skins", "equipSkin"] },
    { "id": "eliteLevel", "group": "meta", "en": "Elite level", "de": "Elite-Stufe", "icon": "league", "text": "Hero levels 21 to 23 after level 20. Only ranked runs in the Elite league group fill them.", "code": ["heroLevels.eliteLevels", "addHeroXp"] },
    { "id": "title", "group": "meta", "en": "Title", "de": "Titel", "icon": "flag", "text": "Words shown with your name on the profile. Never sold, only earned, for example with an Elite level.", "code": ["Profile.equipped.title"] },
    { "id": "heroPin", "group": "meta", "en": "Hero pin", "de": "Helden-Pin", "icon": "star", "text": "A small badge of one hero for the profile, earned at hero level 20 and with each Elite level. Not the shop pin.", "code": ["heroRewardId"] },
    { "id": "heroFrame", "group": "meta", "en": "Hero frame", "de": "Heldenrahmen", "icon": "hero", "text": "A frame around a hero, earned at hero level 20. Draft.", "code": ["heroRewardId"] },
    { "id": "playerPicture", "group": "meta", "en": "Player picture", "de": "Spielerbild", "text": "Your picture on the start screen. Chosen in the profile.", "code": ["Profile.equipped.picture"] },
    { "id": "quest", "group": "meta", "en": "Quest", "de": "Aufgabe", "icon": "quest", "text": "A daily or weekly run with special rules that pays Galaxies.", "code": ["questsScene"] },
    { "id": "creditsShop", "group": "meta", "en": "Shop (Credits)", "de": "Shop (Credits)", "icon": "cart", "text": "Where skins, backgrounds, heroes of earlier seasons and the premium pass are bought. Every purchase shows a preview first.", "code": ["storeScene", "purchaseOverlay"] },

    { "id": "backpack", "group": "backpack", "en": "Backpack", "de": "Rucksack", "text": "Where your bags and items lie. Only what is in the backpack fights.", "code": ["ship (in effects: per.ship, to: ship, shipUse)", "Build", "Board"] },
    { "id": "grid", "group": "backpack", "en": "Grid", "de": "Raster", "text": "The largest area the backpack can cover ({grid.w}×{grid.h} cells). It only becomes usable where bags lie.", "code": ["rules.grid"] },
    { "id": "cell", "group": "backpack", "en": "Cell", "de": "Feld", "icon": "cell", "text": "One square of the grid or of an item's shape.", "code": ["shape '#'"] },
    { "id": "bag", "group": "backpack", "en": "Bag", "de": "Tasche", "icon": "bag", "text": "Items can only lie in bags. Some bags help what lies inside.", "code": ["bag (tag)", "isBag", "to: inside"] },
    { "id": "loose", "group": "backpack", "en": "Loose items", "de": "Lose Items", "text": "Pieces lying below the backpack. They do nothing in the fight. At most {shop.looseLimit} can be bought without placing them.", "code": ["RunState.loose", "shop.looseLimit"] },
    { "id": "turn", "group": "backpack", "en": "Turn", "de": "Drehen", "text": "Items and bags can be turned in steps of 90°.", "code": ["Placement.rot"] },

    { "id": "shop", "group": "shop", "en": "Shop", "de": "Shop", "text": "Offers items and bags for gold every round.", "code": ["rollOffers", "rules.shop"] },
    { "id": "offer", "group": "shop", "en": "Offer", "de": "Angebot", "text": "One item or bag in the shop, {shop.slots} per roll.", "code": ["Offer"] },
    { "id": "reroll", "group": "shop", "en": "Reroll", "de": "Neu würfeln", "text": "New offers for {shop.rerollCost} gold.", "code": ["reroll"] },
    { "id": "pin", "group": "shop", "en": "Pin", "de": "Anpinnen", "text": "A pinned offer stays through rerolls and into the next round.", "code": ["frozen", "toggleFreeze"] },
    { "id": "sale", "group": "shop", "en": "Sale", "de": "Sonderangebot", "text": "Some offers cost half.", "code": ["Offer.sale", "shop.salePct"] },
    { "id": "sell", "group": "shop", "en": "Sell", "de": "Verkaufen", "text": "Gives back {shop.sellPct} % of the price.", "code": ["sellItem", "sellBag", "sellLoose", "sellPrice"] },

    { "id": "item", "group": "items", "en": "Item", "de": "Item", "text": "Anything you buy and pack. Bags are items too, but nothing can lie on them.", "code": ["ItemDef"] },
    { "id": "shape", "group": "items", "en": "Shape", "de": "Form", "text": "The cells an item covers, and its stars.", "code": ["shape"] },
    { "id": "star", "group": "items", "en": "Star", "de": "Stern", "text": "A cell next to an item that it points at. Items lying on its stars are \"starred\".", "code": ["shape '*'", "to: stars", "per.stars", "starUse"] },
    { "id": "effect", "group": "items", "en": "Effect", "de": "Wirkung", "text": "What an item does: a trigger and an action, or a lasting bonus. The rules text is generated from it.", "code": ["Effect", "describeItem"] },
    { "id": "stack", "group": "items", "en": "Stack", "de": "Stapel", "text": "Buffs and debuffs add up in stacks; most effects count per stack.", "code": ["n"] },

