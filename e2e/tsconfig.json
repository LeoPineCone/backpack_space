{
  "$comment": "Browser checks: the Playwright specs (Node) and the reference page (browser).",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "noEmit": true
  },
  "include": [".", "../playwright.config.ts", "../apps/client/src/env.d.ts"]
}
