{
  "name": "backpack-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backpack Space – shared battle core, game client, balancing tools and browser preview",
  "scripts": {
    "validate": "tsx src/cli/validate.ts",
    "battle": "tsx src/cli/battle.ts",
    "sim:reference": "tsx src/cli/reference-fights.ts",
    "data:major": "tsx src/cli/data-major.ts",
    "playtest": "tsx src/cli/playtest.ts",
    "catalog": "tsx src/cli/catalog.ts",
    "art:prompt": "tsx src/cli/art-prompt.ts",
    "lore": "tsx src/cli/lore.ts",
    "i18n": "tsx src/cli/i18n.ts",
    "report:battles": "tsx src/reports/battles.ts",
    "report:heroes": "tsx src/reports/heroes.ts",
    "report:runs": "tsx src/reports/runs.ts",
    "report:items": "tsx src/reports/items.ts",
    "report:recipes": "tsx src/reports/recipes.ts",
    "report:placement": "tsx src/reports/placement.ts",
    "report:paths": "tsx src/reports/paths.ts",
    "report:picks": "tsx src/reports/picks.ts",
    "report:synergy": "tsx src/reports/synergy.ts",
    "report:selftest": "tsx src/reports/selftest.ts",
    "report:strength": "tsx src/reports/strength.ts",
    "report:meta": "tsx src/reports/meta.ts",
    "report:all": "tsx src/reports/all.ts",
    "ratings": "tsx src/reports/items.ts --write-ratings",
    "baseline": "tsx src/balance/baseline.ts",
    "balance:replay": "tsx src/balance/replay.ts",
    "balance:sense": "tsx src/balance/sense.ts",
    "balance:propose": "tsx src/balance/propose.ts",
    "balance:sweep": "tsx src/balance/sweep.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:api": "vitest run --config vitest.api.config.ts",
    "lint": "eslint . && prettier --check \"**/*.{ts,js,mjs}\"",
    "format": "prettier --write \"**/*.{ts,js,mjs}\" && eslint . --fix",
    "check": "npm run validate && npm run typecheck && npm run lint && npm test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p playground && tsc --noEmit -p e2e && npm run typecheck --workspaces --if-present",
    "play": "vite playground",
    "play:build": "vite build playground --outDir ../out/play --emptyOutDir",
    "play:ghosts": "tsx playground/make-ghosts.ts",
    "client": "vite apps/client",
    "client:build": "vite build apps/client --outDir ../../out/client --emptyOutDir",
    "client:build:dev": "vite build apps/client --mode devtools --outDir ../../out/client-dev --emptyOutDir",
    "db": "tsx apps/backend/local/db.ts up",
    "db:stop": "tsx apps/backend/local/db.ts stop",
    "db:reset": "tsx apps/backend/local/db.ts reset",
    "backend": "tsx apps/backend/local/server.ts",
    "dev": "tsx apps/backend/local/dev.ts",
    "app:sync": "npm run cap:sync -w @backpack-space/client",
    "app:ios": "npm run cap:ios -w @backpack-space/client",
    "app:android": "npm run cap:android -w @backpack-space/client",
    "app:run:ios": "npm run cap:run:ios -w @backpack-space/client",
    "app:run:android": "npm run cap:run:android -w @backpack-space/client"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@backpack-space/core": "*"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
